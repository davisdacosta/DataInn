# ============================================
# Server
# ============================================
PORT=5000
NODE_ENV=development

# Set to "true" to run the whole app on simulated providers with NO real
# credentials (fake catalog, fake payments, fake delivery). See README.
# Ignored/forced false when NODE_ENV=production.
MOCK_MODE=true

# Comma-separated list of origins allowed to call this API in production.
# In development, all origins are allowed regardless of this value.
FRONTEND_URL=http://localhost:8080

# ============================================
# DataSika (server-side only — never expose)
# ============================================
DATASIKA_API_KEY=
DATASIKA_BASE_URL=https://nrsfvhztpzwkadwciizp.supabase.co/functions/v1
# Begins with whsec_ — from the DataSika developer console
DATASIKA_WEBHOOK_SECRET=

# ============================================
# Paystack (server-side only — never expose the secret key)
# ============================================
PAYSTACK_SECRET_KEY=
# The public key is safe to expose to the frontend; the backend hands it
# to the frontend via GET /api/payments/config
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ============================================
# Database
# ============================================
# postgres://user:password@host:5432/dbname
# Leave empty to run on the built-in in-memory store (dev/testing only —
# see README "Database modes"). Required when NODE_ENV=production.
DATABASE_URL=

# ============================================
# Admin dashboard (server-side only)
# ============================================
# Keep these for the first admin if already configured.
ADMIN_EMAIL=
# Use a unique password with at least 12 characters in production.
ADMIN_PASSWORD=
# Optional additional admins as a JSON array. Passwords must be at least
# 12 characters in production. Example:
# ADMIN_USERS='[{"email":"second-admin@example.com","password":"replace-with-a-unique-password"}]'

# ============================================
# Rate limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITE=20
RATE_LIMIT_MAX_READ=60
